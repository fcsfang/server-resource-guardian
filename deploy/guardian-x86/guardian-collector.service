[Unit]
Description=Guardian x86 read-only container collector
Documentation=https://github.com/fcsfang/server-resource-guardian
After=local-fs.target network-online.target docker.service
Wants=docker.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=guardian-collector
Group=guardian-shared
SupplementaryGroups=docker
WorkingDirectory=/opt/server-resource-guardian
Environment=PYTHONPATH=/opt/server-resource-guardian
ExecStart=/usr/bin/python3 -m src.guardian_collector_service --socket /run/guardian-collector/collector.sock
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
KillMode=mixed
KillSignal=SIGTERM
LimitNOFILE=1024
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/guardian-collector /var/lib/guardian/shared
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
PrivateDevices=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0007
Slice=guardian-observer.slice
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
RuntimeDirectory=guardian-collector
RuntimeDirectoryMode=0770

[Install]
WantedBy=multi-user.target
