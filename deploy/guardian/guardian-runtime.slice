[Unit]
Description=Guardian runtime control-plane resource domain
Documentation=https://github.com/fcsfang/server-resource-guardian

[Slice]
CPUAccounting=true
IOAccounting=true
MemoryAccounting=true
TasksAccounting=true
# Control-plane budget is separate from the Rescue Plane and is not a
# production calibration. Recheck P99 plus margin on every target host.
CPUWeight=500
IOWeight=500
MemoryMin=32M
MemoryLow=64M
MemoryHigh=384M
MemoryMax=512M
TasksMax=256
