[Unit]
Description=Guardian read-only observer
Documentation=https://github.com/fcsfang/server-resource-guardian
After=local-fs.target docker.service
Wants=docker.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=guardian
Group=guardian
# Observer needs read-only Docker stats/inspect through the local socket. This
# group is powerful; the action broker must remain a separate future unit.
SupplementaryGroups=docker
WorkingDirectory=/opt/server-resource-guardian
Environment=PYTHONPATH=/opt/server-resource-guardian
Environment=GUARDIAN_READY_FILE=/run/guardian/ready
ExecStart=/usr/bin/python3 -m src.guardian_observer --config /etc/guardian/guardian.json --audit-file /var/lib/guardian/audit/events.jsonl
Restart=on-failure
RestartSec=5s
WatchdogSec=60s
TimeoutStartSec=30s
TimeoutStopSec=15s
KillMode=mixed
KillSignal=SIGTERM
OOMScoreAdjust=-900
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/guardian /run/guardian
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
PrivateDevices=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
Slice=guardian-observer.slice
# Journald is the audit transport; keep bursts bounded during failures.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
RuntimeDirectory=guardian
RuntimeDirectoryMode=0750
StateDirectory=guardian
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
