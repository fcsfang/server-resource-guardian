[Unit]
Description=Guardian read-only container Collector resource domain
Documentation=https://github.com/fcsfang/server-resource-guardian

[Slice]
CPUAccounting=true
IOAccounting=true
MemoryAccounting=true
TasksAccounting=true
CPUWeight=50
IOWeight=50
MemoryMin=16M
MemoryLow=32M
MemoryHigh=192M
MemoryMax=256M
TasksMax=128
AllowedCPUs=0
