[Unit]
Description=Disposable HTTP health service for CPU-only reproduction
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/guardian-cpu-repro
ExecStart=/usr/bin/python3 /home/ubuntu/guardian-cpu-repro/http_health_service.py
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
