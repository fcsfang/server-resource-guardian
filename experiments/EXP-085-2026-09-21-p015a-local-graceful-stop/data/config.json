{
  "actions": {
    "allow": [
      "graceful_stop"
    ],
    "cooldown_seconds": 600,
    "enabled": true,
    "graceful_timeout_seconds": 30,
    "max_actions_per_host_per_hour": 1,
    "require_approval": true
  },
  "agent": {
    "interval_seconds": 5,
    "mode": "enforce",
    "snapshot_directory": null,
    "snapshot_max_total_bytes": 268435456
  },
  "audit": {
    "local_buffer_enabled": true,
    "max_total_bytes": 104857600,
    "remote_export_enabled": false
  },
  "protection": {
    "container_labels": [
      "guardian.protected=true"
    ],
    "executable_paths": [],
    "systemd_units": [
      "server-resource-guardian.service",
      "ssh.service",
      "sshd.service"
    ]
  },
  "recovery": {
    "max_wait_seconds": 15,
    "poll_interval_seconds": 0.5,
    "require_business_health": true
  },
  "risk": {
    "composite": {
      "max_sample_age_seconds": 15,
      "psi_memory_full_critical_avg10": 0.5,
      "psi_memory_some_warning_avg10": 1,
      "required_samples": 2,
      "swap_used_critical_percent": 50,
      "swap_used_warning_percent": 25,
      "trend_critical_bytes_per_second": 16777216,
      "trend_warning_bytes_per_second": 1048576
