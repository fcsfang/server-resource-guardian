    "disk_capacity": {
      "critical_for_seconds": 30,
      "critical_free_percent": 5,
      "critical_inode_free_percent": 5,
      "critical_time_to_full_seconds": 3600,
      "max_sample_age_seconds": 15,
      "min_object_contribution_percent": 20,
      "min_object_lead_margin": 0.15,
      "mount_points": [
        "/"
