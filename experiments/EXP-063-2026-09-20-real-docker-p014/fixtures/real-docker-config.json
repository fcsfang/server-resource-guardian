{
  "schema": "guardian.config.v1",
  "version": 1,
  "agent": {
    "mode": "simulate",
    "interval_seconds": 1,
    "snapshot_directory": null,
    "snapshot_max_total_bytes": 1048576
  },
  "risk": {
    "memory": {
      "warning_available_percent": 80,
      "critical_available_percent": 70,
      "warning_for_seconds": 1,
      "critical_for_seconds": 1
    },
    "composite": {
      "required_samples": 1,
      "max_sample_age_seconds": 10,
      "trend_warning_bytes_per_second": 1,
      "trend_critical_bytes_per_second": 1,
      "psi_memory_some_warning_avg10": 100,
      "psi_memory_full_critical_avg10": 100,
      "swap_used_warning_percent": 100,
      "swap_used_critical_percent": 100
    },
    "cpu": {
      "warning_utilization_percent": 10,
      "critical_utilization_percent": 20,
      "warning_psi_some_avg10": 0.1,
      "critical_psi_full_avg10": 0.1,
      "warning_scheduler_delay_ms": 1,
      "critical_scheduler_delay_ms": 2,
      "warning_for_seconds": 1,
      "critical_for_seconds": 1,
      "required_samples": 1,
      "max_sample_age_seconds": 10,
      "min_object_contribution_percent": 20,
      "min_object_lead_margin": 0.15
    },
    "disk_capacity": {
      "mount_points": ["/"],
      "warning_free_percent": 5,
      "critical_free_percent": 2,
      "warning_inode_free_percent": 5,
      "critical_inode_free_percent": 2,
      "warning_time_to_full_seconds": 1,
      "critical_time_to_full_seconds": 1,
      "warning_for_seconds": 1,
      "critical_for_seconds": 1,
      "required_samples": 1,
      "max_sample_age_seconds": 10,
      "min_object_contribution_percent": 20,
      "min_object_lead_margin": 0.15
    },
    "io": {
      "warning_psi_some_avg10": 0.1,
      "critical_psi_full_avg10": 0.1,
      "warning_device_utilization_percent": 1,
      "critical_device_utilization_percent": 5,
      "warning_average_latency_ms": 1,
      "critical_average_latency_ms": 5,
      "warning_for_seconds": 1,
      "critical_for_seconds": 1,
      "required_samples": 1,
      "max_sample_age_seconds": 10,
      "min_object_contribution_percent": 20,
      "min_object_lead_margin": 0.15
    }
  },
  "actions": {
    "enabled": false,
    "require_approval": true,
    "graceful_timeout_seconds": 30,
    "cooldown_seconds": 60,
    "max_actions_per_host_per_hour": 0,
    "allow": []
  },
  "protection": {
    "systemd_units": ["server-resource-guardian.service", "ssh.service", "sshd.service"],
    "executable_paths": [],
    "container_labels": []
  },
  "recovery": {
    "max_wait_seconds": 10,
    "poll_interval_seconds": 1,
    "require_business_health": true
  },
  "audit": {
    "local_buffer_enabled": true,
    "remote_export_enabled": false,
    "max_total_bytes": 1048576
  }
}
