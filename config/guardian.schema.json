{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guardian.config.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "agent", "risk", "actions", "protection", "recovery", "audit"],
  "properties": {
    "schema": {"const": "guardian.config.v1"},
    "version": {"const": 1},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "interval_seconds", "snapshot_directory", "snapshot_max_total_bytes"],
      "properties": {
        "mode": {"enum": ["observe", "simulate", "enforce"]},
        "interval_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "snapshot_directory": {"type": ["string", "null"]},
        "snapshot_max_total_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory", "composite"],
      "properties": {
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warning_available_percent", "critical_available_percent", "warning_for_seconds", "critical_for_seconds"],
          "properties": {
            "warning_available_percent": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100},
            "critical_available_percent": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100},
            "warning_for_seconds": {"type": "number", "exclusiveMinimum": 0},
            "critical_for_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "composite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_samples", "max_sample_age_seconds", "trend_warning_bytes_per_second", "trend_critical_bytes_per_second", "psi_memory_some_warning_avg10", "psi_memory_full_critical_avg10", "swap_used_warning_percent", "swap_used_critical_percent"],
          "properties": {
            "required_samples": {"type": "integer", "minimum": 1, "maximum": 60},
            "max_sample_age_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
            "trend_warning_bytes_per_second": {"type": "number", "minimum": 0},
            "trend_critical_bytes_per_second": {"type": "number", "minimum": 0},
            "psi_memory_some_warning_avg10": {"type": "number", "minimum": 0, "maximum": 100},
            "psi_memory_full_critical_avg10": {"type": "number", "minimum": 0, "maximum": 100},
            "swap_used_warning_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "swap_used_critical_percent": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warning_utilization_percent", "critical_utilization_percent", "warning_psi_some_avg10", "critical_psi_full_avg10", "warning_scheduler_delay_ms", "critical_scheduler_delay_ms", "warning_for_seconds", "critical_for_seconds", "required_samples", "max_sample_age_seconds", "min_object_contribution_percent", "min_object_lead_margin"],
          "properties": {
            "warning_utilization_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
            "critical_utilization_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
            "warning_psi_some_avg10": {"type": "number", "minimum": 0, "maximum": 100},
            "critical_psi_full_avg10": {"type": "number", "minimum": 0, "maximum": 100},
            "warning_scheduler_delay_ms": {"type": "number", "exclusiveMinimum": 0},
            "critical_scheduler_delay_ms": {"type": "number", "exclusiveMinimum": 0},
            "warning_for_seconds": {"type": "number", "exclusiveMinimum": 0},
            "critical_for_seconds": {"type": "number", "exclusiveMinimum": 0},
            "required_samples": {"type": "integer", "minimum": 1, "maximum": 60},
            "max_sample_age_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
            "min_object_contribution_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "min_object_lead_margin": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "disk_capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mount_points", "warning_free_percent", "critical_free_percent", "warning_inode_free_percent", "critical_inode_free_percent", "warning_time_to_full_seconds", "critical_time_to_full_seconds", "warning_for_seconds", "critical_for_seconds", "required_samples", "max_sample_age_seconds", "min_object_contribution_percent", "min_object_lead_margin"],
          "properties": {
            "mount_points": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "warning_free_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
            "critical_free_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
            "warning_inode_free_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
            "critical_inode_free_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
            "warning_time_to_full_seconds": {"type": "number", "exclusiveMinimum": 0},
            "critical_time_to_full_seconds": {"type": "number", "exclusiveMinimum": 0},
            "warning_for_seconds": {"type": "number", "exclusiveMinimum": 0},
            "critical_for_seconds": {"type": "number", "exclusiveMinimum": 0},
            "required_samples": {"type": "integer", "minimum": 1, "maximum": 60},
            "max_sample_age_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
            "min_object_contribution_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "min_object_lead_margin": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "io": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warning_psi_some_avg10", "critical_psi_full_avg10", "warning_device_utilization_percent", "critical_device_utilization_percent", "warning_average_latency_ms", "critical_average_latency_ms", "warning_for_seconds", "critical_for_seconds", "required_samples", "max_sample_age_seconds", "min_object_contribution_percent", "min_object_lead_margin"],
          "properties": {
            "warning_psi_some_avg10": {"type": "number", "minimum": 0, "maximum": 100},
            "critical_psi_full_avg10": {"type": "number", "minimum": 0, "maximum": 100},
            "warning_device_utilization_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
            "critical_device_utilization_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
            "warning_average_latency_ms": {"type": "number", "exclusiveMinimum": 0},
            "critical_average_latency_ms": {"type": "number", "exclusiveMinimum": 0},
            "warning_for_seconds": {"type": "number", "exclusiveMinimum": 0},
            "critical_for_seconds": {"type": "number", "exclusiveMinimum": 0},
            "required_samples": {"type": "integer", "minimum": 1, "maximum": 60},
            "max_sample_age_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
            "min_object_contribution_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "min_object_lead_margin": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "emergency_shedding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "enabled", "window_seconds", "required_samples", "min_host_contribution_percent", "resource_priority", "action", "protected_set", "actionable_set"],
          "properties": {
            "schema": {"const": "guardian.emergency_shedding.v1"},
            "enabled": {"type": "boolean"},
            "window_seconds": {"type": "number", "minimum": 1, "maximum": 60},
            "required_samples": {"type": "integer", "minimum": 1, "maximum": 60},
            "min_host_contribution_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "resource_priority": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 4,
              "maxItems": 4,
              "items": {"enum": ["memory", "cpu", "io", "disk_capacity"]}
            },
            "action": {"const": "graceful_stop"},
            "protected_set": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stable_id", "owner", "reason"],
                "properties": {
                  "stable_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "owner": {"type": "string", "minLength": 1},
                  "reason": {"type": "string", "minLength": 1}
                }
              }
            },
            "actionable_set": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stable_id", "owner", "environment", "allowed_resources", "action", "grace_timeout_seconds", "expires_at", "human_contact"],
                "properties": {
                  "stable_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "owner": {"type": "string", "minLength": 1},
                  "environment": {"const": "local-disposable"},
                  "allowed_resources": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"enum": ["memory", "cpu", "io", "disk_capacity"]}
                  },
                  "action": {"const": "graceful_stop"},
                  "grace_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
                  "expires_at": {"type": "string", "minLength": 1},
                  "human_contact": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "disk_reserve_recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "root", "mount_point", "max_releases_per_incident", "authorization_file"],
          "properties": {
            "enabled": {"type": "boolean"},
            "root": {"const": "/var/lib/guardian/reserve"},
            "mount_point": {"type": "string", "pattern": "^/"},
            "max_releases_per_incident": {"const": 1},
            "authorization_file": {"type": ["string", "null"], "pattern": "^/"}
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "require_approval", "authorization_file", "graceful_timeout_seconds", "cooldown_seconds", "max_actions_per_host_per_hour", "allow"],
      "properties": {
        "enabled": {"type": "boolean"},
        "require_approval": {"type": "boolean"},
        "authorization_file": {"type": ["string", "null"], "pattern": "^/"},
        "graceful_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "cooldown_seconds": {"type": "number", "minimum": 0},
        "max_actions_per_host_per_hour": {"type": "integer", "minimum": 0},
        "allow": {"type": "array", "uniqueItems": true, "items": {"enum": ["graceful_stop", "restart", "terminate"]}}
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemd_units", "executable_paths", "container_labels"],
      "properties": {
        "systemd_units": {"type": "array", "items": {"type": "string"}},
        "executable_paths": {"type": "array", "items": {"type": "string"}},
        "container_labels": {"type": "array", "items": {"type": "string"}}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wait_seconds", "poll_interval_seconds", "require_business_health"],
      "properties": {
        "max_wait_seconds": {"type": "number", "exclusiveMinimum": 0},
        "poll_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "require_business_health": {"type": "boolean"}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_buffer_enabled", "remote_export_enabled", "max_total_bytes"],
      "properties": {
        "local_buffer_enabled": {"type": "boolean"},
        "remote_export_enabled": {"type": "boolean"},
        "max_total_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
